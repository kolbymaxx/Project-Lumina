# Copy to boot/config.env (optional) or export before lumina-boot.sh.

# This XR
LUMINA_UDID=00008020-00117540340B002E
LUMINA_ECID=00117540340B002E

# Known-good Mac paths (override if yours differ)
RAMDISK_ROOT="${HOME}/Projects/usbliter8-xr-ramdisk"
USBLITER8CTL="${HOME}/Projects/usbliter8-jailbreak/usbliter8ctl"

# Host tools
IRECOVERY=irecovery
PYTHON=python3
IPROXY=iproxy
SSHPASS=sshpass
IDEVICE_ID=idevice_id

# SSH
SSH_PORT_LOCAL=2222
SSH_USER=root
SSH_PASS=alpine

# Boot-args used after Recovery (same family as hsbugss exploit.sh)
BOOTARGS='rd=md0 -v debug=0x2014e serial=3 wdt=-1 amfi_get_out_of_my_way=1 pmap_cs_allow_any_signature=1'
