#!/usr/bin/env python3
"""Host utility for a device exploited by usbliter8."""

import argparse
import errno
import os
import sys
import time
from contextlib import contextmanager

try:
    import usb.core
    import usb.util
except ImportError:
    print("error: pyusb is required (python3 -m pip install pyusb)", file=sys.stderr)
    sys.exit(1)


VENDOR = 0x05AC
PID_DFU = 0x1227
PID_RECOVERY = 0x1281

DFU_DNLOAD = 1
DFU_GETSTATUS = 3
DFU_CLRSTATUS = 4
DFU_ABORT = 6
CUSTOM_DEMOTE = 7
CUSTOM_BOOT = 8

TRANSFER_SIZE = 0x800
INTERFACE = 0
HOST_TO_DEVICE_CLASS_INTERFACE = 0x21
DEVICE_TO_HOST_CLASS_INTERFACE = 0xA1
CONTROL_TIMEOUT_MS = 100
CUSTOM_BOOT_TIMEOUT_MS = 2000
GETSTATUS_TIMEOUT_MS = 1000
MAX_MANIFEST_POLLS = 20
POST_BOOT_SCAN_SECONDS = 5.0
POST_BOOT_SCAN_INTERVAL = 0.25
PWND_MARKER = "PWND:[usbliter8]"

DFU_STATES = {
    0: "APP_IDLE",
    1: "APP_DETACH",
    2: "DFU_IDLE",
    3: "DNLOAD_SYNC",
    4: "DNLOAD_BUSY",
    5: "DNLOAD_IDLE",
    6: "MANIFEST_SYNC",
    7: "MANIFEST",
    8: "MANIFEST_WAIT_RESET",
    9: "UPLOAD_IDLE",
    10: "ERROR",
}
DFU_MANIFEST_WAIT_RESET = 8
DFU_ERROR = 10


class ToolError(Exception):
    """An error that should be shown without a traceback."""


def find_device(pid):
    return usb.core.find(idVendor=VENDOR, idProduct=pid)


def device_serial(dev):
    if not dev.iSerialNumber:
        return ""
    try:
        return usb.util.get_string(dev, dev.iSerialNumber) or ""
    except usb.core.USBError as exc:
        return "<unavailable: {}>".format(exc)


def require_pwned_dfu():
    dev = find_device(PID_DFU)
    if dev is None:
        raise ToolError(
            "Pwned DFU device {:04x}:{:04x} was not found".format(
                VENDOR, PID_DFU
            )
        )
    return dev


def verify_pwned(dev):
    serial = device_serial(dev)
    if serial.startswith("<unavailable:"):
        raise ToolError("could not read the DFU serial: {}".format(serial))
    if PWND_MARKER not in serial:
        raise ToolError(
            "DFU device is not marked as pwned (serial: {!r})".format(serial)
        )
    return serial


def try_set_configuration(dev):
    """Configure the device when possible; macOS may report it as already set."""
    try:
        dev.set_configuration()
    except usb.core.USBError as exc:
        print("note: set_configuration failed; continuing: {}".format(exc))


@contextmanager
def claim_device(dev):
    usb.util.claim_interface(dev, INTERFACE)
    try:
        yield
    finally:
        try:
            usb.util.release_interface(dev, INTERFACE)
        except usb.core.USBError:
            # A successful boot can disconnect the old DFU device immediately.
            pass
        usb.util.dispose_resources(dev)


def is_pipe_stall(exc):
    """Return True for the EPIPE/libusb PIPE forms used for USB stalls."""
    if getattr(exc, "errno", None) == errno.EPIPE:
        return True
    # PyUSB's libusb1 backend uses LIBUSB_ERROR_PIPE (-9).
    if getattr(exc, "backend_error_code", None) == -9:
        return True
    text = str(exc).lower()
    return "pipe error" in text or "stall" in text


def control_request_allow_stall(
    dev, request, name, timeout=CONTROL_TIMEOUT_MS
):
    try:
        dev.ctrl_transfer(
            HOST_TO_DEVICE_CLASS_INTERFACE,
            request,
            0,
            INTERFACE,
            None,
            timeout=timeout,
        )
    except usb.core.USBError as exc:
        if is_pipe_stall(exc):
            print(
                "note: {} ended with a USB pipe/stall; "
                "continuing, but this does not prove that boot succeeded".format(
                    name
                )
            )
            return
        raise


def do_info(_args):
    found = False
    for pid, default_status in (
        (PID_DFU, "DFU"),
        (PID_RECOVERY, "Recovery"),
    ):
        devices = usb.core.find(
            find_all=True, idVendor=VENDOR, idProduct=pid
        )
        for dev in devices:
            found = True
            serial = device_serial(dev)
            status = default_status
            if pid == PID_DFU and PWND_MARKER in serial:
                status = "Pwned DFU"
            print("{:04x}:{:04x} {}".format(VENDOR, pid, status))
            print("serial: {}".format(serial or "<none>"))

    if not found:
        raise ToolError(
            "no DFU or Recovery device found "
            "({:04x}:{:04x} or {:04x}:{:04x})".format(
                VENDOR, PID_DFU, VENDOR, PID_RECOVERY
            )
        )


def do_demote(_args):
    dev = require_pwned_dfu()
    try_set_configuration(dev)

    with claim_device(dev):
        verify_pwned(dev)
        control_request_allow_stall(dev, CUSTOM_DEMOTE, "CUSTOM_DEMOTE")

    print("demote request sent")


def upload_dfu_image(dev, image):
    sent = 0
    chunk_number = 0
    while sent < len(image):
        chunk = image[sent : sent + TRANSFER_SIZE]
        transferred = dev.ctrl_transfer(
            HOST_TO_DEVICE_CLASS_INTERFACE,
            DFU_DNLOAD,
            0,
            0,
            chunk,
            timeout=CONTROL_TIMEOUT_MS,
        )
        if transferred != len(chunk):
            raise ToolError(
                "short DFU transfer in chunk {}: sent {} of {} bytes".format(
                    chunk_number, transferred, len(chunk)
                )
            )
        sent += transferred
        chunk_number += 1

    print("sent - 0x{:x}".format(sent))


def finish_dfu_download(dev):
    """Send the empty DNLOAD that starts the DFU manifestation phase."""
    transferred = dev.ctrl_transfer(
        HOST_TO_DEVICE_CLASS_INTERFACE,
        DFU_DNLOAD,
        0,
        0,
        None,
        timeout=CONTROL_TIMEOUT_MS,
    )
    if transferred not in (0, None):
        raise ToolError(
            "final empty DNLOAD unexpectedly transferred {} bytes".format(
                transferred
            )
        )
    print("final empty DNLOAD sent")


def send_custom_boot(dev):
    control_request_allow_stall(
        dev,
        CUSTOM_BOOT,
        "CUSTOM_BOOT",
        timeout=CUSTOM_BOOT_TIMEOUT_MS,
    )


def send_dfu_abort(dev, send_abort):
    if send_abort:
        control_request_allow_stall(dev, DFU_ABORT, "DFU_ABORT")
    else:
        print("note: DFU_ABORT omitted for this boot attempt")


def get_dfu_status(dev):
    response = dev.ctrl_transfer(
        DEVICE_TO_HOST_CLASS_INTERFACE,
        DFU_GETSTATUS,
        0,
        0,
        6,
        timeout=GETSTATUS_TIMEOUT_MS,
    )
    if len(response) != 6:
        raise ToolError(
            "DFU_GETSTATUS returned {} bytes instead of 6".format(
                len(response)
            )
        )

    status = int(response[0])
    poll_timeout_ms = (
        int(response[1])
        | (int(response[2]) << 8)
        | (int(response[3]) << 16)
    )
    state = int(response[4])
    state_name = DFU_STATES.get(state, "UNKNOWN")
    print(
        "GETSTATUS: state={} ({}), status={}, poll={}ms".format(
            state, state_name, status, poll_timeout_ms
        )
    )
    return status, poll_timeout_ms, state


def wait_for_manifest_reset(dev):
    for _ in range(MAX_MANIFEST_POLLS):
        status, poll_timeout_ms, state = get_dfu_status(dev)
        if status != 0 or state == DFU_ERROR:
            raise ToolError(
                "DFU manifestation failed: status={}, state={} ({})".format(
                    status, state, DFU_STATES.get(state, "UNKNOWN")
                )
            )
        if state == DFU_MANIFEST_WAIT_RESET:
            return
        if poll_timeout_ms:
            time.sleep(poll_timeout_ms / 1000.0)

    raise ToolError(
        "DFU did not reach MANIFEST_WAIT_RESET after {} GETSTATUS requests".format(
            MAX_MANIFEST_POLLS
        )
    )


def reset_after_boot(dev, should_reset):
    if not should_reset:
        print("note: USB reset omitted for this boot attempt")
        return

    print("issuing USB reset from MANIFEST_WAIT_RESET")
    try:
        dev.reset()
    except usb.core.USBError as exc:
        # A reset can invalidate the old handle if re-enumeration starts.
        print(
            "note: USB reset returned {}; continuing to verify USB identity".format(
                exc
            )
        )


def run_boot_sequence(
    dev, image, send_abort, should_reset, boot_before_final_dnload
):
    upload_dfu_image(dev, image)

    if boot_before_final_dnload:
        print("experimental order: CUSTOM_BOOT before final empty DNLOAD")
        send_custom_boot(dev)

    finish_dfu_download(dev)
    wait_for_manifest_reset(dev)

    if not boot_before_final_dnload:
        send_custom_boot(dev)

    send_dfu_abort(dev, send_abort)
    reset_after_boot(dev, should_reset)


def scan_device_serial(pid):
    dev = find_device(pid)
    if dev is None:
        return None
    try:
        return device_serial(dev)
    finally:
        usb.util.dispose_resources(dev)


def scan_after_boot(previous_serial, timeout):
    print(
        "scanning for Recovery {:04x}:{:04x} for up to {:.1f}s...".format(
            VENDOR, PID_RECOVERY, timeout
        )
    )
    deadline = time.monotonic() + timeout
    last_dfu_serial = None

    while True:
        recovery_serial = scan_device_serial(PID_RECOVERY)
        if recovery_serial is not None:
            print(
                "success: found Recovery {:04x}:{:04x}".format(
                    VENDOR, PID_RECOVERY
                )
            )
            print("serial: {}".format(recovery_serial or "<none>"))
            return

        dfu_serial = scan_device_serial(PID_DFU)
        if dfu_serial is not None:
            last_dfu_serial = dfu_serial
            serial_is_readable = not dfu_serial.startswith("<unavailable:")
            if (
                serial_is_readable
                and dfu_serial
                and dfu_serial != previous_serial
            ):
                print(
                    "success: device re-enumerated as {:04x}:{:04x} "
                    "with a new identity".format(VENDOR, PID_DFU)
                )
                print("serial: {}".format(dfu_serial))
                return

        if time.monotonic() >= deadline:
            break
        time.sleep(POST_BOOT_SCAN_INTERVAL)

    if last_dfu_serial is not None:
        raise ToolError(
            "CUSTOM_BOOT did not leave SecureROM: device remains "
            "{:04x}:{:04x} (serial: {})".format(
                VENDOR, PID_DFU, last_dfu_serial or "<none>"
            )
        )
    raise ToolError(
        "device disappeared, but did not re-enumerate as Recovery "
        "{:04x}:{:04x} within {:.1f}s".format(
            VENDOR, PID_RECOVERY, timeout
        )
    )


def do_boot(args):
    image_path = os.path.expanduser(args.image)
    try:
        with open(image_path, "rb") as image_file:
            image = image_file.read()
    except OSError as exc:
        raise ToolError("could not read {!r}: {}".format(image_path, exc))

    if not image:
        raise ToolError("refusing to boot an empty image")
    if args.post_boot_timeout < 0:
        raise ToolError("--post-boot-timeout cannot be negative")

    dev = require_pwned_dfu()
    previous_serial = verify_pwned(dev)
    is_macos = sys.platform == "darwin"
    send_abort = args.abort if args.abort is not None else not is_macos
    should_reset = args.reset if args.reset is not None else is_macos

    if is_macos:
        print(
            "macOS minimal mode: no set_configuration or interface claim; "
            "connect the phone directly to the Mac"
        )
        try:
            run_boot_sequence(
                dev,
                image,
                send_abort,
                should_reset,
                args.boot_before_final_dnload,
            )
        finally:
            # Release the macOS USB handle before checking for re-enumeration.
            usb.util.dispose_resources(dev)
    else:
        try_set_configuration(dev)
        with claim_device(dev):
            run_boot_sequence(
                dev,
                image,
                send_abort,
                should_reset,
                args.boot_before_final_dnload,
            )

    scan_after_boot(previous_serial, args.post_boot_timeout)


def parse_pid(value):
    text = str(value).strip().lower()
    if text.startswith("0x"):
        text = text[2:]
    try:
        pid = int(text, 16)
    except ValueError:
        raise argparse.ArgumentTypeError(
            "PID must be hexadecimal, for example 0x1281 or 1281"
        )
    if not 0 <= pid <= 0xFFFF:
        raise argparse.ArgumentTypeError("PID must be between 0000 and ffff")
    return pid


def do_wait(args):
    print(
        "waiting for {:04x}:{:04x} (press Ctrl-C to stop)...".format(
            VENDOR, args.pid
        )
    )
    while find_device(args.pid) is None:
        time.sleep(args.interval)
    print("found {:04x}:{:04x}".format(VENDOR, args.pid))


def do_send(args):
    print(
        "send is not implemented yet; Recovery bulk upload for {!r} "
        "will be added later".format(args.image)
    )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="usbliter8ctl",
        description="Control an Apple device exploited by usbliter8",
    )
    subparsers = parser.add_subparsers(dest="command")
    subparsers.required = True

    info_parser = subparsers.add_parser(
        "info", help="show a connected DFU or Recovery device"
    )
    info_parser.set_defaults(func=do_info)

    demote_parser = subparsers.add_parser(
        "demote", help="send CUSTOM_DEMOTE to a Pwned DFU device"
    )
    demote_parser.set_defaults(func=do_demote)

    boot_parser = subparsers.add_parser(
        "boot", help="upload and boot a raw image on a Pwned DFU device"
    )
    boot_parser.add_argument("image", help="raw iBSS/iBoot image")
    abort_group = boot_parser.add_mutually_exclusive_group()
    abort_group.add_argument(
        "--no-abort",
        dest="abort",
        action="store_false",
        help="omit DFU_ABORT after CUSTOM_BOOT (the macOS default)",
    )
    abort_group.add_argument(
        "--abort",
        dest="abort",
        action="store_true",
        help="send DFU_ABORT after CUSTOM_BOOT (the non-macOS default)",
    )
    reset_group = boot_parser.add_mutually_exclusive_group()
    reset_group.add_argument(
        "--reset",
        dest="reset",
        action="store_true",
        help="issue a USB reset after CUSTOM_BOOT (the macOS default)",
    )
    reset_group.add_argument(
        "--no-reset",
        dest="reset",
        action="store_false",
        help="do not issue a USB reset after CUSTOM_BOOT",
    )
    boot_parser.add_argument(
        "--boot-before-final-dnload",
        action="store_true",
        help="experimentally send CUSTOM_BOOT before the empty DNLOAD",
    )
    boot_parser.add_argument(
        "--post-boot-timeout",
        type=float,
        default=POST_BOOT_SCAN_SECONDS,
        help="seconds to scan for re-enumeration (default: 5)",
    )
    boot_parser.set_defaults(abort=None, reset=None)
    boot_parser.set_defaults(func=do_boot)

    wait_parser = subparsers.add_parser(
        "wait", help="wait until an Apple USB device appears"
    )
    wait_parser.add_argument(
        "--pid",
        type=parse_pid,
        default=PID_RECOVERY,
        help="USB product ID in hex (default: 0x1281)",
    )
    wait_parser.add_argument(
        "--interval",
        type=float,
        default=0.25,
        help=argparse.SUPPRESS,
    )
    wait_parser.set_defaults(func=do_wait)

    send_parser = subparsers.add_parser(
        "send", help="placeholder for a future Recovery bulk upload"
    )
    send_parser.add_argument("image", help="image to send later")
    send_parser.set_defaults(func=do_send)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except ToolError as exc:
        print("error: {}".format(exc), file=sys.stderr)
        return 1
    except usb.core.USBError as exc:
        print("USB error: {}".format(exc), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nstopped", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
